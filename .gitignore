# The QEMU lab keeps all VM data outside the working tree (see
# docs/dev/vm-lab.md), under $ANDARU_LAB_DIR, default ~/vm/andaru. These
# patterns are a backstop in case anything is ever run from inside the checkout.
*.qcow2
*.fd
*.iso
*.meta
*.sock
*.pid
SHA512SUMS
/images/
/golden/
/overlays/
/seeds/
/run/
/logs/

# Graphify: the root graph is committed so a fresh clone can query it without a
# rebuild; everything else in graphify-out/ is regenerated locally.
*.graphify-bak
graphify-out/*
!graphify-out/graph.json
