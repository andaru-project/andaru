### /run/andaru-kea/kea-dhcp4.conf 0644 secret=false sources=/dhcp
{
  "Dhcp4": {
    "control-socket": {
      "socket-name": "/run/kea/kea4-ctrl-socket",
      "socket-type": "unix"
    },
    "hooks-libraries": [
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_run_script.so",
        "parameters": {
          "name": "/usr/share/kea/scripts/andaru-lease-event",
          "sync": false
        }
      }
    ],
    "interfaces-config": {
      "interfaces": [
        "ens19"
      ],
      "service-sockets-max-retries": 30,
      "service-sockets-retry-wait-time": 2000
    },
    "lease-database": {
      "lfc-interval": 3600,
      "persist": true,
      "type": "memfile"
    },
    "subnet4": [
      {
        "id": 1,
        "option-data": [
          {
            "data": "192.168.40.1",
            "name": "routers"
          },
          {
            "data": "192.168.40.1",
            "name": "domain-name-servers"
          },
          {
            "data": "lan.example",
            "name": "domain-name"
          }
        ],
        "pools": [
          {
            "pool": "192.168.40.128 - 192.168.40.254"
          }
        ],
        "reservations": [],
        "subnet": "192.168.40.0/24",
        "user-context": {
          "andaru": {
            "domain": "lan.example",
            "register": false
          }
        },
        "valid-lifetime": 3600
      }
    ]
  }
}

### /run/andaru-unbound/andaru.conf 0644 secret=false sources=/dhcp,/dns
server:
	interface: 127.0.0.1
	interface: ::1
	# Unbound may start before networkd has the addresses.
	ip-freebind: yes
	interface: 192.168.40.1
	access-control: 127.0.0.0/8 allow
	access-control: ::1/128 allow
	access-control: 192.168.40.0/24 allow
	local-zone: "lan.example." static
	tls-cert-bundle: /etc/ssl/certs/ca-certificates.crt
forward-zone:
	name: "."
	forward-addr: 9.9.9.9#dns.quad9.net
	forward-addr: 2620:fe::fe@853#dns.quad9.net
	forward-tls-upstream: yes

### /run/systemd/network/50-andaru-ens18.link 0644 secret=false sources=/links/0
[Match]
PermanentMACAddress=52:54:00:aa:bb:01

[Link]
Name=ens18

### /run/systemd/network/50-andaru-ens18.network 0644 secret=false sources=/links/0,/segments/0
[Match]
PermanentMACAddress=52:54:00:aa:bb:01

[Link]
RequiredForOnline=no
MTUBytes=1500

[Network]
LLDP=no
DHCP=yes
IPv6AcceptRA=yes

[DHCPv4]
UseDNS=no
UseNTP=no
UseHostname=no
UseDomains=no

[DHCPv6]
UseDNS=no
UseNTP=no
UseHostname=no
UseDomains=no
PrefixDelegationHint=::/56

[IPv6AcceptRA]
UseDNS=no
UseDomains=no

### /run/systemd/network/50-andaru-ens19.link 0644 secret=false sources=/links/1
