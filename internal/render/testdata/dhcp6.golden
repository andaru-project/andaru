### /run/andaru-kea/kea-dhcp6.conf 0644 secret=false sources=/dhcp6
{
  "Dhcp6": {
    "control-socket": {
      "socket-name": "/run/kea/kea6-ctrl-socket",
      "socket-type": "unix"
    },
    "hooks-libraries": [
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_run_script.so",
        "parameters": {
          "name": "/usr/share/kea/scripts/andaru-lease-event",
          "sync": false
        }
      }
    ],
    "interfaces-config": {
      "interfaces": [
        "ens19"
      ],
      "service-sockets-max-retries": 30,
      "service-sockets-retry-wait-time": 2000
    },
    "lease-database": {
      "lfc-interval": 3600,
      "persist": true,
      "type": "memfile"
    },
    "subnet6": [
      {
        "id": 240797876,
        "interface": "ens19",
        "option-data": [
          {
            "data": "fd00:1::1",
            "name": "dns-servers"
          },
          {
            "data": "home.arpa",
            "name": "domain-search"
          }
        ],
        "pd-pools": [
          {
            "delegated-len": 56,
            "excluded-prefix": "fd00:beef:1:ff::",
            "excluded-prefix-len": 64,
            "prefix": "fd00:beef:1::",
            "prefix-len": 48
          }
        ],
        "pools": [
          {
            "pool": "fd00:1::1000 - fd00:1::1fff"
          }
        ],
        "preferred-lifetime": 4500,
        "reservations": [
          {
            "duid": "00:01:00:01:aa:bb:cc:dd:ee:ff",
            "hostname": "nas",
            "ip-addresses": [
              "fd00:1::10"
            ],
            "prefixes": [
              "fd00:beef:1:100::/56"
            ]
          }
        ],
        "subnet": "fd00:1::/64",
        "user-context": {
          "andaru": {
            "domain": "home.arpa",
            "register": true
          }
        },
        "valid-lifetime": 7200
      }
    ]
  }
}

### /run/andaru-unbound/andaru.conf 0644 secret=false sources=/dhcp,/dns
server:
	interface: 127.0.0.1
	interface: ::1
	# Unbound may start before networkd has the addresses.
	ip-freebind: yes
	interface: 192.0.2.1
	interface: fd00:1::1
	access-control: 127.0.0.0/8 allow
	access-control: ::1/128 allow
	access-control: 192.0.2.0/24 allow
	access-control: fd00:1::/64 allow
	access-control: fd00:beef:1::/48 allow
	local-zone: "home.arpa." static
	local-data: "nas.home.arpa. 3600 IN AAAA fd00:1::10"
	local-data-ptr: "fd00:1::10 3600 nas.home.arpa."

