### /run/andaru-unbound/andaru.conf 0644 secret=false sources=/dhcp,/dns
server:
	interface: 127.0.0.1
	interface: ::1
	# Unbound may start before networkd has the addresses.
	ip-freebind: yes
	interface: 192.0.2.1
	interface: 172.16.53.53
	interface: fd00:53:53:53:53:53:53:53
	access-control: 127.0.0.0/8 allow
	access-control: ::1/128 allow
	access-control: 192.0.2.0/24 allow
	interface-action: 172.16.53.53 allow
	interface-action: fd00:53:53:53:53:53:53:53 allow
	local-zone: "." static

