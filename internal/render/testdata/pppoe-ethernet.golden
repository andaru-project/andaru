### /run/systemd/network/50-andaru-pp000000020000.network 0644 secret=false sources=/links/1,/segments/0
[Match]
Name=pp000000020000
Type=ppp

[Link]
RequiredForOnline=no

[Network]
KeepConfiguration=yes
