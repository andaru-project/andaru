### /run/andaru-unbound/andaru.conf 0644 secret=false sources=/dhcp,/dns
server:
	interface: 127.0.0.1
	interface: ::1
	# Unbound may start before networkd has the addresses.
	ip-freebind: yes
	interface: 192.168.40.1
	interface: fd00:a5d:1::1
	interface: fd00:a5d:2::1
	access-control: 127.0.0.0/8 allow
	access-control: ::1/128 allow
	access-control: 192.168.40.0/24 allow
	interface-action: fd00:a5d:1::1 allow
	interface-action: fd00:a5d:2::1 allow
	local-zone: "home.arpa." static

### /run/systemd/network/50-andaru-ens18.link 0644 secret=false sources=/links/0
[Match]
PermanentMACAddress=52:54:00:aa:bb:01

[Link]
Name=ens18

### /run/systemd/network/50-andaru-ens18.network 0644 secret=false sources=/links/0,/segments/0
[Match]
PermanentMACAddress=52:54:00:aa:bb:01

[Link]
RequiredForOnline=no
MTUBytes=1500

[Network]
LLDP=no
DHCP=yes
IPv6AcceptRA=yes

[DHCPv4]
UseDNS=no
UseNTP=no
UseHostname=no
UseDomains=no

[DHCPv6]
WithoutRA=solicit
DUIDType=4
DUIDRawData=aa:bb:cc:dd
UseDNS=no
UseNTP=no
UseHostname=no
UseDomains=no
PrefixDelegationHint=::/56
UseAddress=no
SendRelease=no

[IPv6AcceptRA]
UseDNS=no
UseDomains=no

### /run/systemd/network/50-andaru-ens19.link 0644 secret=false sources=/links/1
