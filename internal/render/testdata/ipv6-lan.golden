### /run/systemd/network/50-andaru-ens19.network 0644 secret=false sources=/links/1,/segments/1
[Match]
PermanentMACAddress=52:54:00:aa:bb:02

[Link]
RequiredForOnline=no
MTUBytes=1500

[Network]
LLDP=no
Address=192.168.40.1/24
Address=fd00:a5d:1::1/64
IPv6AcceptRA=no
DHCPPrefixDelegation=yes
IPv6SendRA=yes

[DHCPPrefixDelegation]
UplinkInterface=ens18
SubnetId=0x0
Assign=yes
Announce=yes

[IPv6SendRA]
RouterPreference=high
RouterLifetimeSec=1800
Managed=no
OtherInformation=no
EmitDNS=yes
DNS=fd00:a5d:1::1
EmitDomains=yes
Domains=home.arpa example.org

[IPv6Prefix]
Prefix=fd00:a5d:1::/64

