### /run/andaru-kea/kea-dhcp4.conf 0644 secret=false sources=/dhcp
{
  "Dhcp4": {
    "control-socket": {
      "socket-name": "/run/kea/kea4-ctrl-socket",
      "socket-type": "unix"
    },
    "hooks-libraries": [
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_run_script.so",
        "parameters": {
          "name": "/usr/share/kea/scripts/andaru-lease-event",
          "sync": false
        }
      }
    ],
    "interfaces-config": {
      "interfaces": [
        "ens19"
      ],
      "service-sockets-max-retries": 30,
      "service-sockets-retry-wait-time": 2000
    },
    "lease-database": {
      "lfc-interval": 3600,
      "persist": true,
      "type": "memfile"
    },
    "subnet4": [
      {
        "id": 240797876,
        "option-data": [
          {
            "data": "192.168.40.1",
            "name": "routers"
          },
          {
            "data": "192.168.40.1",
            "name": "domain-name-servers"
          },
          {
            "data": "home.arpa",
            "name": "domain-name"
          }
        ],
        "pools": [
          {
            "pool": "192.168.40.128 - 192.168.40.254"
          }
        ],
        "reservations": [],
        "subnet": "192.168.40.0/24",
        "user-context": {
          "andaru": {
            "domain": "home.arpa",
            "register": true
          }
        },
        "valid-lifetime": 7200
      }
    ]
  }
}

### /run/andaru-unbound/andaru.conf 0644 secret=false sources=/dhcp,/dns
server:
	interface: 127.0.0.1
	interface: ::1
	# Unbound may start before networkd has the addresses.
	ip-freebind: yes
	interface: 192.168.40.1
	access-control: 127.0.0.0/8 allow
	access-control: ::1/128 allow
	access-control: 192.168.40.0/24 allow
	local-zone: "home.arpa." static

