### /run/systemd/system/andaru-pppoe-pp000000030000.service 0644 secret=false sources=/links/2,/segments/0
[Unit]
Description=Andaru PPPoE session pp000000030000
BindsTo=sys-subsystem-net-devices-vl000000020000.device
Wants=systemd-networkd.service
After=sys-subsystem-net-devices-vl000000020000.device systemd-networkd.service

[Service]
Type=notify
ExecStartPre=/usr/lib/systemd/systemd-networkd-wait-online --interface=vl000000020000:carrier --timeout=60
ExecStart=/usr/sbin/pppd file /run/andaru/ppp/pp000000030000.options nodetach up_sdnotify
ExecReload=/bin/kill -HUP $MAINPID
SuccessExitStatus=5
Restart=on-failure
RestartSec=5

