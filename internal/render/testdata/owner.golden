### /run/andaru/ppp/pp000000030000.options 0600 secret=true sources=/links/2,/segments/0
plugin pppoe.so
nic-vl000000020000
ifname pp000000030000
linkname pp000000030000
user "kpn@internet"
password "kpn"
noauth
nolog
hide-password
persist
maxfail 0
holdoff 10
lcp-echo-interval 15
lcp-echo-failure 4
mtu 1500
mru 1500
noipdefault
defaultroute
+ipv6
ipv6cp-use-persistent

