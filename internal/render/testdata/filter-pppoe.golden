### /run/systemd/system/andaru-pppoe-pp000000020000.service 0644 secret=false sources=/links/1,/segments/0
[Unit]
Description=Andaru PPPoE session pp000000020000
BindsTo=sys-subsystem-net-devices-enx\x2d1.2.device
Wants=systemd-networkd.service
After=sys-subsystem-net-devices-enx\x2d1.2.device systemd-networkd.service

[Service]
Type=notify
ExecStartPre=/usr/lib/systemd/systemd-networkd-wait-online --interface=enx-1.2:carrier --timeout=60
ExecStart=/usr/sbin/pppd file /run/andaru-ppp/pp000000020000.options nodetach up_sdnotify
ExecReload=/bin/kill -HUP $MAINPID
SuccessExitStatus=5
Restart=on-failure
RestartSec=5

### nft:inet/andaru 0644 secret=false sources=/aliases,/management,/nat,/rules
# interface enx-1.2 52:54:00:aa:bb:01
# interface ens19 52:54:00:aa:bb:02
table inet andaru {}
delete table inet andaru
table inet andaru {
	comment "sha256:512c6bc99067e13e2a10b034f3b687f646dd6b9f7af613cfbfce5a99e17f9fa7"
	set zon_00000001_0000_4000_8000_000000000001 { type ifname; elements = { "pp000000020000" }; }
	set zon_00000002_0000_4000_8000_000000000002 { type ifname; elements = { "ens19" }; }
	set uplinks { type ifname; elements = { "pp000000020000" }; }
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif lo accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
		ip6 saddr fe80::/10 icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } accept
		iifname "ens19" tcp dport 22 accept
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		iifname "pp000000020000" meta nfproto ipv4 tcp flags syn / syn,rst tcp option maxseg size > 1452 tcp option maxseg size set 1452
		iifname "pp000000020000" meta nfproto ipv6 tcp flags syn / syn,rst tcp option maxseg size > 1432 tcp option maxseg size set 1432
		oifname "pp000000020000" meta nfproto ipv4 tcp flags syn / syn,rst tcp option maxseg size > 1452 tcp option maxseg size set 1452
		oifname "pp000000020000" meta nfproto ipv6 tcp flags syn / syn,rst tcp option maxseg size > 1432 tcp option maxseg size set 1432
		ct state established,related accept
		ct state invalid drop
		iifname @zon_00000002_0000_4000_8000_000000000002 accept comment "rul_00000001-0000-4000-8000-000000000001"
	}
	chain postrouting {
		type nat hook postrouting priority srcnat;
		fib saddr type != local oifname @uplinks meta nfproto ipv4 masquerade
	}
}

