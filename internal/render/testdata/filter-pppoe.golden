### /run/andaru-ppp/pp000000020000.options 0600 secret=true sources=/links/1,/segments/0
plugin pppoe.so
nic-enx-1.2
ifname pp000000020000
linkname pp000000020000
user "kpn@internet"
password "kpn"
noauth
nolog
hide-password
persist
maxfail 0
holdoff 10
lcp-echo-interval 15
lcp-echo-failure 4
mtu 1492
mru 1492
noipdefault
defaultroute
+ipv6
ipv6cp-use-persistent

