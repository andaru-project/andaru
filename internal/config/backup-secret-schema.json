{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andaru.invalid/private/backup-config-secrets-v1",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 1 },
    "secrets": {
      "type": "object",
      "properties": {
        "core": {
          "type": "object",
          "propertyNames": { "$ref": "https://andaru.invalid/api/v1/schema#/$defs/secretName" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["password", "notification", "pki", "acme", "wireguard", "ipsec", "openvpn"] },
              "value": { "type": "string", "maxLength": 8192 }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          }
        }
      },
      "patternProperties": {
        "^addon:[a-z][a-z0-9-]{0,31}(\\.[a-z][a-z0-9-]{0,31})+$": {
          "type": "object",
          "propertyNames": { "$ref": "https://andaru.invalid/api/v1/schema#/$defs/secretName" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": { "const": "addon" },
              "value": { "type": "string", "maxLength": 8192 }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          }
        }
      },
      "required": ["core"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "secrets"],
  "additionalProperties": false
}
