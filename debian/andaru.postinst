#!/bin/sh
set -e

case "$1" in
configure)
	# A restart of Debian's nftables.service flushes the whole ruleset, Andaru's filter included. Masking does not
	# stop a running unit and changes no rule now.
	if ! systemctl mask nftables.service >/dev/null 2>&1; then
		echo "andaru: could not mask nftables.service; a restart of it would flush Andaru's filter." >&2
	fi
	if systemctl is-active --quiet nftables.service 2>/dev/null; then
		echo "andaru: nftables.service is masked; its ruleset stays loaded until the next boot." >&2
	fi
	/usr/share/andaru/andaru-apparmor
	;;
triggered)
	/usr/share/andaru/andaru-apparmor
	;;
esac

# Nothing here restarts systemd-networkd or touches an interface: installing must not drop the administrator's link.

#DEBHELPER#
