#!/bin/sh
set -e

root=${DPKG_ROOT:-}
case "$1" in
configure)
	# nftables.service is masked when a takeover is confirmed, not here: until then a reboot keeps the host's firewall.
	"$root/usr/share/andaru/andaru-apparmor"
	# Andaru's drop-ins start Kea from /run/andaru-kea only, which a confirmed generation writes.
	if [ ! -e "$root/var/lib/andaru/generations/pointers.json" ]; then
		for v in 4 6; do
			if [ -x "$root/usr/sbin/kea-dhcp$v" ] && [ -f "$root/etc/kea/kea-dhcp$v.conf" ]; then
				echo "andaru: kea-dhcp$v-server now serves only Andaru's configuration, not /etc/kea/kea-dhcp$v.conf; it stops serving DHCP at its next restart." >&2
			fi
		done
	fi
	;;
triggered)
	"$root/usr/share/andaru/andaru-apparmor"
	;;
esac

# Nothing here restarts systemd-networkd or touches an interface: installing must not drop the administrator's link.

#DEBHELPER#
