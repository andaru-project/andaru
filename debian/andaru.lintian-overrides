# Andaru is built with CGO_ENABLED=0 on purpose: one binary, no libc dependency, as the lab and releases run it.
andaru: statically-linked-binary [usr/bin/andaru]
# Masking nftables.service, another package's unit, is deliberate: a restart of it flushes Andaru's ruleset.
andaru: maintainer-script-calls-systemctl [postinst:*]
