#!/bin/sh
set -e

# Debian's convention: remove deletes nothing; purge deletes everything Andaru created. prerm already refuses a
# remove while Andaru runs the network or a factory reset is unfinished, so a purge reaches only a host whose
# takeover was undone or whose removal was forced. Portable backups live elsewhere and stay.
# The include lines andaru-apparmor added go with the rules they name; the administrator's own lines stay.
if [ "$1" = purge ]; then
	pointers=${DPKG_ROOT:-}/var/lib/andaru/generations/pointers.json
	if [ -e "${DPKG_ROOT:-}/var/lib/andaru-reset/operation.json" ] ||
		{ [ -f "$pointers" ] && grep -Eq '"takeover"[[:space:]]*:[[:space:]]*true' "$pointers"; }; then
		echo "andaru: purging a host Andaru still configured: its network state, kept recovery copies and any unfinished factory reset are deleted." >&2
	fi
	for tree in /etc/andaru /var/lib/andaru /var/lib/andaru-kept /var/lib/andaru-upgrades /var/lib/andaru-reset; do
		tree=${DPKG_ROOT:-}$tree
		[ -d "$tree" ] || continue
		# Contents first. -H follows only a tree that is itself a link, to empty where it points; no link inside is
		# followed. -xdev leaves anything mounted inside alone, and a tree that is a mount point keeps its empty directory.
		find -H "$tree" -xdev -mindepth 1 -delete 2>/dev/null ||
			echo "andaru: left what is mounted or busy under $tree" >&2
		if [ -L "$tree" ]; then
			rm -f "$tree"
		else
			rmdir "$tree" 2>/dev/null || :
		fi
	done
	for daemon in kea-dhcp4 kea-dhcp6 unbound; do
		local_file=${DPKG_ROOT:-}/etc/apparmor.d/local/usr.sbin.$daemon
		if [ -f "$local_file" ]; then
			# --follow-symlinks: an administrator's symlinked local file stays a symlink.
			sed --follow-symlinks -i "/^include if exists <andaru\/$daemon>\$/d" "$local_file"
		fi
	done
fi

#DEBHELPER#
