#include <tunables/global>

profile andaru-web /usr/bin/andaru-web flags=(attach_disconnected) {
  #include <abstractions/base>

  network inet stream,
  network inet6 stream,
  network unix stream,

  /usr/bin/andaru-web mr,
  /usr/share/andaru/web/** r,
  /etc/andaru/** r,
  /run/andaru-web/engine.sock rw,
}
