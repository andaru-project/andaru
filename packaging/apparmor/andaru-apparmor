#!/bin/sh
# Installed as /usr/share/andaru/andaru-apparmor; the andaru package's postinst runs it, under dpkg's DPKG_ROOT.
# Debian's profiles include /etc/apparmor.d/local/usr.sbin.<daemon>, a file the administrator owns, so Andaru adds
# one line naming its own rules there instead of replacing the file. debian/andaru.postrm removes it on purge.
set -eu

root=${DPKG_ROOT:-}
for daemon in kea-dhcp4 kea-dhcp6 unbound; do
	profile=$root/etc/apparmor.d/usr.sbin.$daemon
	local_file=$root/etc/apparmor.d/local/usr.sbin.$daemon
	line="include if exists <andaru/$daemon>"
	[ -f "$profile" ] || continue
	if [ ! -f "$local_file" ] || ! grep -qxF "$line" "$local_file"; then
		mkdir -p "$(dirname "$local_file")"
		# A last line without a newline would swallow the include (into a comment, say).
		if [ -s "$local_file" ] && [ "$(tail -c 1 "$local_file" | od -An -c | tr -d ' ')" != '\n' ]; then
			echo >>"$local_file"
		fi
		printf '%s\n' "$line" >>"$local_file"
	fi
	# Without a kernel AppArmor (a container, or an offline root without /sys) or the parser, the rules load at the next boot.
	if command -v apparmor_parser >/dev/null && [ -d "$root/sys/kernel/security/apparmor" ]; then
		if apparmor_parser -r -T -W "$profile"; then
			# The daemon's own postinst may have started it before these rules were loaded (Andaru only recommends
			# it, so it is configured first): its reads of Andaru's files were denied and it gave up. Start it again.
			unit=unbound.service
			[ "$daemon" = unbound ] || unit=$daemon-server.service
			# deb-systemd-invoke skips a disabled unit and respects policy-rc.d, as a maintainer script must.
			if systemctl is-failed --quiet "$unit" 2>/dev/null; then
				systemctl reset-failed "$unit" || true
				deb-systemd-invoke start "$unit" || echo "andaru: $unit did not start; see journalctl -u $unit" >&2
			fi
		else
			echo "andaru: could not reload the AppArmor profile $profile" >&2
		fi
	fi
done
