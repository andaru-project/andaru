[Unit]
Description=Andaru confirmed network generation
DefaultDependencies=no
RequiresMountsFor=/var/lib/andaru
# Its lock and pointers are written under /var/lib/andaru, so the root file system must be writable.
After=systemd-remount-fs.service
ConditionPathExists=/var/lib/andaru/generations/pointers.json
Before=systemd-networkd.service systemd-resolved.service networking.service network-pre.target cloud-init-local.service shutdown.target
# A mask boot restores must win over nftables.service starting and flushing Andaru's table.
Before=nftables.service
Conflicts=shutdown.target

[Service]
Type=oneshot
TimeoutStartSec=30
ExecStart=/usr/bin/andaru realize boot

[Install]
WantedBy=sysinit.target
