[Unit]
Description=Andaru confirmed network generation
DefaultDependencies=no
RequiresMountsFor=/var/lib/andaru
ConditionPathExists=/var/lib/andaru/generations/pointers.json
Before=systemd-networkd.service network-pre.target cloud-init-local.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
TimeoutStartSec=30
ExecStart=/usr/bin/andaru realize boot

[Install]
WantedBy=sysinit.target
