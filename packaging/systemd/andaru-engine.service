[Unit]
Description=Andaru local control-plane engine
After=local-fs.target

[Service]
Type=exec
User=root
Group=root
EnvironmentFile=-/etc/andaru/engine-web.conf
ExecStart=/usr/bin/andaru engine $ANDARU_ENGINE_WEB_ARGS
RuntimeDirectory=andaru
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# andaru-kept is on the root disk, outside the wipeable tree; the engine records last-lan/ and stores recovery/ there.
StateDirectory=andaru andaru-kept
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
# No capability is needed to hand the web socket to the andaru-web group: an owner may chgrp to a group it is in
# (internal/engine/socket_linux.go). The group comes from sysusers.d; without it the unit does not start.
# ProtectSystem=strict makes /run read-only; tmpfiles.d creates /run/andaru-web, and the engine starts without it.
# The same holds for the services bus socket in /run/andaru-services and the andaru-services group.
SupplementaryGroups=andaru-web andaru-services
ReadWritePaths=-/run/andaru-web -/run/andaru-services
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
StandardOutput=journal
StandardError=journal
SyslogIdentifier=andaru-engine

[Install]
WantedBy=multi-user.target
