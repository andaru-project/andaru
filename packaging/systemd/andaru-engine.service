[Unit]
Description=Andaru local control-plane engine
After=local-fs.target

[Service]
Type=exec
User=root
Group=root
EnvironmentFile=-/etc/andaru/engine-web.conf
ExecStart=/usr/bin/andaru engine $ANDARU_ENGINE_WEB_ARGS
RuntimeDirectory=andaru
RuntimeDirectoryMode=0700
# andaru-kept is on the root disk, outside the wipeable tree; the engine records last-lan/ and stores recovery/ there.
StateDirectory=andaru andaru-kept
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
StandardOutput=journal
StandardError=journal
SyslogIdentifier=andaru-engine

[Install]
WantedBy=multi-user.target
