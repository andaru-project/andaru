; Unbound runs as named_t, which cannot read var_run_t files. Andaru writes Unbound's settings and the DHCP lease
; names into these directories, so they carry Unbound's configuration type; files created in them inherit it.
(filecon "/run/andaru-unbound(/.*)?" any (system_u object_r named_conf_t ((s0) (s0))))
(filecon "/run/andaru-leases(/.*)?" any (system_u object_r named_conf_t ((s0) (s0))))
; pppd runs as pppd_t, which reads its configuration type. Andaru writes each PPPoE session's options here.
(filecon "/run/andaru-ppp(/.*)?" any (system_u object_r pppd_etc_t ((s0) (s0))))
; Add-on containers run as container_t and connect to the token-authenticated add-on event bus socket bind-mounted
; from /run/andaru-addons/bus-socket. andaru-engine runs as unconfined_service_t.
(filecon "/run/andaru-addons/bus-socket(/.*)?" any (system_u object_r container_file_t ((s0) (s0))))
(allow container_t unconfined_service_t (unix_stream_socket (connectto)))
; strongSwan (ipsec_t, ipsec_mgmt_t) reads swanctl.conf and its credentials from /run/andaru-ipsec; OpenVPN reads its
; configuration from /run/andaru-openvpn and creates its management sockets under /run/andaru-openvpn/run.
(filecon "/run/andaru-ipsec(/.*)?" any (system_u object_r ipsec_conf_file_t ((s0) (s0))))
(filecon "/run/andaru-openvpn(/.*)?" any (system_u object_r openvpn_etc_t ((s0) (s0))))
(filecon "/run/andaru-openvpn/run(/.*)?" any (system_u object_r openvpn_var_run_t ((s0) (s0))))
