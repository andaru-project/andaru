{
    "default": [
        {
            "type": "reject"
        }
    ],
    "transports": {
        "docker": {
            "": [
                {
                    "type": "insecureAcceptAnything"
                }
            ],
            "@NAMESPACE@/andaru-nightly": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/andaru-nightly.pub",
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ],
            "@NAMESPACE@": [
                {
                    "type": "sigstoreSigned",
                    "keyPath": "/etc/pki/containers/andaru.pub",
                    "signedIdentity": {
                        "type": "matchRepository"
                    }
                }
            ]
        },
        "docker-daemon": {
            "": [
                {
                    "type": "insecureAcceptAnything"
                }
            ]
        },
        "containers-storage": {
            "": [
                {
                    "type": "insecureAcceptAnything"
                }
            ]
        },
        "oci": {
            "": [
                {
                    "type": "insecureAcceptAnything"
                }
            ]
        },
        "oci-archive": {
            "": [
                {
                    "type": "insecureAcceptAnything"
                }
            ]
        },
        "docker-archive": {
            "": [
                {
                    "type": "insecureAcceptAnything"
                }
            ]
        },
        "dir": {
